# Copy to config.env (chmod 600). Loaded by systemd via EnvironmentFile.

# Pi-hole v6 — the web/API password. Leave blank to disable the Pi-hole panels.
PIHOLE_URL=https://127.0.0.1
PIHOLE_PASSWORD=

# What to probe every 60s for latency / jitter / loss.
GATEWAY=192.168.10.1
ISP_BOX=192.168.1.1
INTERNET_TARGET=1.1.1.1

# NIC on this box, for the fallback "line usage" reading.
IFACE=enp2s0

# Cudy router (stock firmware). Leave ROUTER_PASSWORD blank to disable router panels.
ROUTER_URL=http://192.168.10.1
ROUTER_PASSWORD=
ROUTER_WAN_IFACE=eth1.2

# Optional tuning (seconds / days)
#PROBE_INTERVAL=60
#THROUGHPUT_INTERVAL=900
#SYSLOG_INTERVAL=300
#RETENTION_DAYS=7
#THROUGHPUT_URL=https://speed.cloudflare.com/__down?bytes=5000000
